{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "teacher-app",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8001",
        "--directory",
        "teacher_app"
      ],
      "port": 8001
    },
    {
      "name": "fusul-landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "landing"
      ],
      "port": 3100
    },
    {
      "name": "fusul-landing-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3200",
        "--directory",
        "landing/out"
      ],
      "port": 3200
    },
    {
      "name": "fusul-cinematic",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3300",
        "--directory",
        "landing-cinematic"
      ],
      "port": 3300
    }
  ]
}